datasource db {
  provider = "sqlite"
}

// Prisma 7: TypeScript client generated into the server, connected through @prisma/adapter-better-sqlite3
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Int      @default(0) @map("is_system")
  permissions String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model User {
  id                  Int            @id @default(autoincrement())
  username            String         @unique
  email               String?        @unique
  password            String
  fullName            String         @map("full_name")
  role                String         @default("cashier")
  status              String         @default("active")
  totpSecret          String?        @map("totp_secret")
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until")
  createdAt           DateTime       @default(now()) @map("created_at")
  sales               Sale[]
  saleReturns         SaleReturn[]
  purchases           Purchase[]
  dailyClosings       DailyClosing[]
  cashierShifts       CashierShift[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Company {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  contactPerson   String?          @map("contact_person")
  phone           String?
  email           String?
  address         String?
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  products        Product[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  supplierPayments SupplierPayment[]

  @@map("companies")
}

model Product {
  id                  Int                  @id @default(autoincrement())
  companyId           Int?                 @map("company_id")
  cCode               String               @map("c_code")
  pCode               String               @unique @map("p_code")
  barcode             String?
  name                String
  genericName         String?              @map("generic_name")
  unitType            String               @default("Tablets") @map("unit_type")
  packing             Int                  @default(1)
  boxTradePrice       Float                @default(0.0) @map("box_trade_price")
  boxRetailPrice      Float                @default(0.0) @map("box_retail_price")
  unitTradePrice      Float                @default(0.0) @map("unit_trade_price")
  unitRetailPrice     Float                @default(0.0) @map("unit_retail_price")
  defaultDiscountPct  Float                @default(0.0) @map("default_discount_pct")
  locationRack        String?              @map("location_rack")
  stockBoxes          Int                  @default(0) @map("stock_boxes")
  stockLoose          Int                  @default(0) @map("stock_loose")
  minStockAlert       Int                  @default(10) @map("min_stock_alert")
  allowOpenSale       Int                  @default(1) @map("allow_open_sale")
  minSaleQty          Int                  @default(1) @map("min_sale_qty")
  schedule            String               @default("none")
  status              String               @default("active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  batches             ProductBatch[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([cCode], name: "idx_products_c_code")
  @@index([pCode], name: "idx_products_p_code")
  @@index([barcode], name: "idx_products_barcode")
  @@index([name], name: "idx_products_name")
  @@map("products")
}

model ProductBatch {
  id            Int        @id @default(autoincrement())
  productId     Int        @map("product_id")
  batchNo       String     @map("batch_no")
  expiryDate    String     @map("expiry_date")
  purchaseCost  Float      @default(0.0) @map("purchase_cost")
  retailPrice   Float      @default(0.0) @map("retail_price")
  quantityBoxes Int        @default(0) @map("quantity_boxes")
  quantityLoose Int        @default(0) @map("quantity_loose")
  createdAt     DateTime   @default(now()) @map("created_at")

  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  saleAllocations SaleItemBatch[]

  @@index([expiryDate], name: "idx_batches_expiry")
  @@map("product_batches")
}

model Customer {
  id             Int               @id @default(autoincrement())
  name           String
  phone          String?
  address        String?
  creditLimit    Float             @default(0.0) @map("credit_limit")
  currentBalance Float             @default(0.0) @map("current_balance")
  createdAt      DateTime          @default(now()) @map("created_at")
  payments       CustomerPayment[]
  sales          Sale[]

  @@map("customers")
}

model CustomerPayment {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  amount          Float
  paymentMethod   String   @default("cash") @map("payment_method")
  notes           String?
  previousBalance Float    @map("previous_balance")
  newBalance      Float    @map("new_balance")
  userName        String?  @map("user_name")
  paymentDate     DateTime @default(now()) @map("payment_date")
  shiftId         Int?     @map("shift_id")

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shift           CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@map("customer_payments")
}

model Sale {
  id                Int          @id @default(autoincrement())
  invoiceNo         String       @unique @map("invoice_no")
  customerId        Int?         @map("customer_id")
  customerName      String?      @default("Counter Customer") @map("customer_name")
  customerPhone     String?      @map("customer_phone")
  userId            Int?         @map("user_id")
  userName          String?      @map("user_name")
  saleDate          DateTime     @default(now()) @map("sale_date")
  totalGross        Float        @default(0.0) @map("total_gross")
  totalItemDiscount Float        @default(0.0) @map("total_item_discount")
  billDiscountPct   Float        @default(0.0) @map("bill_discount_pct")
  billDiscountAmt   Float        @default(0.0) @map("bill_discount_amt")
  netTotal          Float        @default(0.0) @map("net_total")
  cashTendered      Float        @default(0.0) @map("cash_tendered")
  changeDue         Float        @default(0.0) @map("change_due")
  paymentType       String       @default("Cash") @map("payment_type")
  status            String       @default("completed")
  notes             String?
  shiftId           Int?         @map("shift_id")
  storeNameSnapshot     String?  @map("store_name_snapshot")
  storeAddressSnapshot  String?  @map("store_address_snapshot")
  invoiceFooterSnapshot String?  @map("invoice_footer_snapshot")
  createdAt         DateTime     @default(now()) @map("created_at")

  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  shift             CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items             SaleItem[]
  returns           SaleReturn[]
  prescriptions     PrescriptionRecord[]

  @@index([invoiceNo], name: "idx_sales_invoice_no")
  @@index([saleDate], name: "idx_sales_date")
  @@map("sales")
}

model SaleItem {
  id             Int           @id @default(autoincrement())
  saleId         Int           @map("sale_id")
  productId      Int           @map("product_id")
  cCode          String        @map("c_code")
  pCode          String        @map("p_code")
  productName    String        @map("product_name")
  unitType       String        @map("unit_type")
  locationRack   String?       @map("location_rack")
  isLoose        Int           @default(0) @map("is_loose")
  quantity       Float
  unitPrice      Float         @map("unit_price")
  unitCost       Float         @map("unit_cost")
  grossAmount    Float         @map("gross_amount")
  discountPct    Float         @default(0.0) @map("discount_pct")
  discountAmount Float         @default(0.0) @map("discount_amount")
  netAmount      Float         @map("net_amount")
  batchId        Int?          @map("batch_id")

  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product       @relation(fields: [productId], references: [id])
  batch          ProductBatch? @relation(fields: [batchId], references: [id])
  batchAllocations SaleItemBatch[]
  prescriptions  PrescriptionRecord[]

  @@map("sale_items")
}

model SaleReturn {
  id                Int              @id @default(autoincrement())
  returnNo          String           @unique @map("return_no")
  saleId            Int?             @map("sale_id")
  originalInvoiceNo String?          @map("original_invoice_no")
  customerName      String?          @map("customer_name")
  refundAmount      Float            @default(0.0) @map("refund_amount")
  reason            String?
  userId            Int?             @map("user_id")
  userName          String?          @map("user_name")
  shiftId           Int?             @map("shift_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  sale              Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  shift             CashierShift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items             SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id              Int        @id @default(autoincrement())
  saleReturnId    Int        @map("sale_return_id")
  productId       Int        @map("product_id")
  productName     String     @map("product_name")
  isLoose         Int        @default(0) @map("is_loose")
  quantity        Float
  unitRefundPrice Float      @map("unit_refund_price")
  totalRefund     Float      @map("total_refund")

  saleReturn      SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id])

  @@map("sale_return_items")
}

model Purchase {
  id                Int              @id @default(autoincrement())
  invoiceNo         String           @unique @map("invoice_no")
  supplierInvoiceNo String?          @map("supplier_invoice_no")
  companyId         Int              @map("company_id")
  companyName       String           @map("company_name")
  purchaseDate      String           @map("purchase_date")
  totalGross        Float            @default(0.0) @map("total_gross")
  discountAmount    Float            @default(0.0) @map("discount_amount")
  taxAmount         Float            @default(0.0) @map("tax_amount")
  netTotal          Float            @default(0.0) @map("net_total")
  paymentStatus     String           @default("Paid") @map("payment_status")
  paidAmount        Float            @default(0.0) @map("paid_amount")
  userId            Int?             @map("user_id")
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")

  company           Company          @relation(fields: [companyId], references: [id])
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             PurchaseItem[]
  returns           PurchaseReturn[]

  @@map("purchases")
}

model PurchaseItem {
  id             Int      @id @default(autoincrement())
  purchaseId     Int      @map("purchase_id")
  productId      Int      @map("product_id")
  productName    String   @map("product_name")
  batchNo        String   @map("batch_no")
  expiryDate     String   @map("expiry_date")
  quantityBoxes  Int      @map("quantity_boxes")
  bonusBoxes     Int      @default(0) @map("bonus_boxes")
  boxCostPrice   Float    @map("box_cost_price")
  boxRetailPrice Float    @map("box_retail_price")
  discountPct    Float    @default(0.0) @map("discount_pct")
  totalCost      Float    @map("total_cost")

  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id])
  returnItems    PurchaseReturnItem[]

  @@map("purchase_items")
}

model PurchaseReturn {
  id          Int                  @id @default(autoincrement())
  returnNo    String               @unique @map("return_no")
  purchaseId  Int?                 @map("purchase_id")
  companyId   Int                  @map("company_id")
  companyName String               @map("company_name")
  returnDate  String               @map("return_date")
  totalRefund Float                @default(0.0) @map("total_refund")
  reason      String?
  isExpiryClaim Int                @default(0) @map("is_expiry_claim")
  userId      Int?                 @map("user_id")
  userName    String?              @map("user_name")
  createdAt   DateTime             @default(now()) @map("created_at")

  purchase    Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  company     Company              @relation(fields: [companyId], references: [id])
  items       PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int            @map("purchase_return_id")
  productId        Int            @map("product_id")
  productName      String?        @map("product_name")
  purchaseItemId   Int?           @map("purchase_item_id")
  batchNo          String?        @map("batch_no")
  quantityBoxes    Int            @map("quantity_boxes")
  boxCostPrice     Float          @map("box_cost_price")
  totalRefund      Float          @map("total_refund")

  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
  purchaseItem     PurchaseItem?  @relation(fields: [purchaseItemId], references: [id])

  @@map("purchase_return_items")
}

model SaleItemBatch {
  id            Int          @id @default(autoincrement())
  saleItemId    Int          @map("sale_item_id")
  batchId       Int          @map("batch_id")
  units         Int
  returnedUnits Int          @default(0) @map("returned_units")

  saleItem      SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch         ProductBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([saleItemId], name: "idx_sale_item_batches_item")
  @@map("sale_item_batches")
}

model PrescriptionRecord {
  id             Int      @id @default(autoincrement())
  saleId         Int      @map("sale_id")
  saleItemId     Int      @map("sale_item_id")
  productId      Int      @map("product_id")
  productName    String   @map("product_name")
  quantity       Float
  isLoose        Int      @default(0) @map("is_loose")
  patientName    String   @map("patient_name")
  patientPhone   String?  @map("patient_phone")
  patientCnic    String?  @map("patient_cnic")
  doctorName     String   @map("doctor_name")
  doctorRegNo    String?  @map("doctor_reg_no")
  prescriptionNo String   @map("prescription_no")
  notes          String?
  userId         Int?     @map("user_id")
  userName       String?  @map("user_name")
  createdAt      DateTime @default(now()) @map("created_at")

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem       SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleId], name: "idx_prescription_records_sale")
  @@index([createdAt], name: "idx_prescription_records_created")
  @@map("prescription_records")
}

model SupplierPayment {
  id            Int      @id @default(autoincrement())
  companyId     Int      @map("company_id")
  amount        Float
  paymentMethod String   @default("cash") @map("payment_method")
  reference     String?
  notes         String?
  paymentDate   String   @map("payment_date")
  userId        Int?     @map("user_id")
  userName      String?  @map("user_name")
  createdAt     DateTime @default(now()) @map("created_at")

  company       Company  @relation(fields: [companyId], references: [id])

  @@index([companyId], name: "idx_supplier_payments_company")
  @@map("supplier_payments")
}

model DailyClosing {
  id                 Int       @id @default(autoincrement())
  closingDate        String    @unique @map("closing_date")
  openingTime        DateTime  @map("opening_time")
  closingTime        DateTime? @map("closing_time")
  userId             Int?      @map("user_id")
  userName           String?   @map("user_name")
  openingCash        Float     @default(0.0) @map("opening_cash")
  totalSalesCash     Float     @default(0.0) @map("total_sales_cash")
  totalSalesCard     Float     @default(0.0) @map("total_sales_card")
  totalSalesCredit   Float     @default(0.0) @map("total_sales_credit")
  totalReturns       Float     @default(0.0) @map("total_returns")
  totalPurchasesPaid Float     @default(0.0) @map("total_purchases_paid")
  expensesTotal      Float     @default(0.0) @map("expenses_total")
  expectedCash       Float     @default(0.0) @map("expected_cash")
  actualCash         Float     @default(0.0) @map("actual_cash")
  difference         Float     @default(0.0) @map("difference")
  invoicesCount      Int       @default(0) @map("invoices_count")
  totalCostOfGoods   Float     @default(0.0) @map("total_cost_of_goods")
  customerPaymentsCash Float   @default(0.0) @map("customer_payments_cash")
  netProfit          Float     @default(0.0) @map("net_profit")
  openShiftsAtClose  Int       @default(0) @map("open_shifts_at_close")
  autoClosed         Int       @default(0) @map("auto_closed")
  notes              String?
  isClosed           Int       @default(0) @map("is_closed")
  createdAt          DateTime  @default(now()) @map("created_at")

  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("daily_closings")
}

model Expense {
  id            Int           @id @default(autoincrement())
  category      String
  amount        Float
  paymentMethod String        @default("cash") @map("payment_method")
  reference     String?
  notes         String?
  expenseDate   String        @map("expense_date")
  shiftId       Int?          @map("shift_id")
  userId        Int?          @map("user_id")
  userName      String?       @map("user_name")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  shift         CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([expenseDate], name: "idx_expenses_date")
  @@index([shiftId], name: "idx_expenses_shift")
  @@map("expenses")
}

model StockCount {
  id        Int              @id @default(autoincrement())
  countNo   String           @unique @map("count_no")
  title     String?
  notes     String?
  companyId Int?             @map("company_id")
  status    String           @default("open")
  userId    Int?             @map("user_id")
  userName  String?          @map("user_name")
  appliedAt DateTime?        @map("applied_at")
  appliedBy String?          @map("applied_by")
  createdAt DateTime         @default(now()) @map("created_at")

  items     StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id           Int        @id @default(autoincrement())
  countId      Int        @map("count_id")
  productId    Int        @map("product_id")
  productName  String     @map("product_name")
  systemUnits  Int        @default(0) @map("system_units")
  countedUnits Int?       @map("counted_units")
  countedAt    DateTime?  @map("counted_at")
  userName     String?    @map("user_name")

  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@index([countId], name: "idx_stock_count_items_count")
  @@map("stock_count_items")
}

model StockAdjustment {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  deltaUnits  Int      @map("delta_units")
  stockBefore Int      @map("stock_before")
  stockAfter  Int      @map("stock_after")
  reason      String
  notes       String?
  batchId     Int?     @map("batch_id")
  unitCost    Float    @default(0.0) @map("unit_cost")
  countId     Int?     @map("count_id")
  userId      Int?     @map("user_id")
  userName    String?  @map("user_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], name: "idx_stock_adjustments_created")
  @@index([productId], name: "idx_stock_adjustments_product")
  @@map("stock_adjustments")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model BackupHistory {
  id             Int      @id @default(autoincrement())
  backupFilename String   @map("backup_filename")
  backupPath     String   @map("backup_path")
  backupType     String   @map("backup_type")
  fileSizeBytes  Int      @map("file_size_bytes")
  status         String   @default("success")
  checksumSha256 String?  @map("checksum_sha256")
  verified       Int      @default(1)
  errorMessage   String?  @map("error_message")
  secondaryPath  String?  @map("secondary_path")
  cloudStatus    String?  @map("cloud_status")
  cloudFileId    String?  @map("cloud_file_id")
  cloudUploadedAt DateTime? @map("cloud_uploaded_at")
  cloudError     String?  @map("cloud_error")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("backup_history")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  module       String
  details      String?
  affectedUser String?  @map("affected_user")
  status       String   @default("SUCCESS")
  userId       Int?     @map("user_id")
  userName     String?  @map("user_name")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model CashierShift {
  id                    Int               @id @default(autoincrement())
  shiftNo               String            @unique @map("shift_no")
  userId                Int               @map("user_id")
  userName              String            @map("user_name")
  startTime             DateTime          @map("start_time")
  endTime               DateTime?         @map("end_time")
  durationMinutes       Int?              @map("duration_minutes")
  openingCash           Float             @default(0.0) @map("opening_cash")
  closingCash           Float?            @map("closing_cash")
  expectedCash          Float?            @map("expected_cash")
  cashDifference        Float?            @map("cash_difference")
  totalSalesCount       Int               @default(0) @map("total_sales_count")
  totalSalesAmount      Float             @default(0.0) @map("total_sales_amount")
  totalCashSales        Float             @default(0.0) @map("total_cash_sales")
  totalCardSales        Float             @default(0.0) @map("total_card_sales")
  totalCreditSales      Float             @default(0.0) @map("total_credit_sales")
  totalReturnsAmount    Float             @default(0.0) @map("total_returns_amount")
  totalCustomerPayments Float             @default(0.0) @map("total_customer_payments")
  totalExpensesCash     Float             @default(0.0) @map("total_expenses_cash")
  notes                 String?
  status                String            @default("open")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales                 Sale[]
  saleReturns           SaleReturn[]
  customerPayments      CustomerPayment[]
  expenses              Expense[]

  @@index([userId, status], name: "idx_shifts_user_status")
  @@index([shiftNo], name: "idx_shifts_shift_no")
  @@index([startTime], name: "idx_shifts_start_time")
  @@map("cashier_shifts")
}
