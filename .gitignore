# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-electron/
dist-server/

# SQLite Databases & WAL/SHM Runtime Files
data/*.db
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# Keep data & backup folders in git while ignoring their contents
!data/.gitkeep
!backups/.gitkeep

# Local backups & SHA-256 sidecars
backups/*.db
backups/*.sha256
backups/pharmacy_backup_*

# Environment variables & local credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
