{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready offline Pharmacy Management System Desktop Application",
  "main": "out/main/index.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "tsx watch server/api.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "prisma generate && tsc && vite build",
    "lint": "tsc --noEmit",
    "test:functional": "tsx server/tests/functional_test.ts",
    "test:phase1": "tsx server/tests/phase1_test.ts",
    "test:phase2": "tsx server/tests/phase2_test.ts",
    "test:phase3": "tsx server/tests/phase3_test.ts",
    "test:phase4": "tsx server/tests/phase4_test.ts",
    "test:phase5": "tsx server/tests/phase5_test.ts",
    "developer:key": "tsx scripts/developer-key.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "start": "node dist-server/api.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "build:unpack": "electron-vite build && npm run native:reset && electron-builder --dir && npm run rebuild:node",
    "build:win": "electron-vite build && npm run native:reset && electron-builder --win nsis && npm run rebuild:node",
    "rebuild:electron": "npm run native:reset && electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3 && npm run native:reset",
    "native:reset": "node -e \"require('fs').rmSync('node_modules/better-sqlite3/build/Release/.forge-meta',{force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "electron-winstaller": false
  }
}
