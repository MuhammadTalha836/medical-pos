{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PharmaCare Pro – 100% Offline POS",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron.mjs dev",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "node scripts/electron.mjs test server/tests/functional_test.ts",
    "test:phase1": "node scripts/electron.mjs test server/tests/phase1_test.ts",
    "test:phase2": "node scripts/electron.mjs test server/tests/phase2_test.ts",
    "test:phase3": "node scripts/electron.mjs test server/tests/phase3_test.ts",
    "test:phase4": "node scripts/electron.mjs test server/tests/phase4_test.ts",
    "test:phase5": "node scripts/electron.mjs test server/tests/phase5_test.ts",
    "test:phase6": "node scripts/electron.mjs test server/tests/phase6_test.ts",
    "test:phase7": "node scripts/electron.mjs test server/tests/phase7_test.ts",
    "test:phase8": "node scripts/electron.mjs test server/tests/phase8_test.ts",
    "test:m1": "node scripts/electron.mjs test server/tests/m1_test.ts",
    "test:m2": "node scripts/electron.mjs test server/tests/m2_test.ts",
    "test:m3": "node scripts/electron.mjs test server/tests/m3_test.ts",
    "test:m4": "node scripts/electron.mjs test server/tests/m4_test.ts",
    "test:m5": "node scripts/electron.mjs test server/tests/m5_test.ts",
    "test:m6": "node scripts/electron.mjs test server/tests/m6_test.ts",
    "test:m7": "node scripts/electron.mjs test server/tests/m7_test.ts",
    "test:m8": "node scripts/electron.mjs test server/tests/m8_test.ts",
    "test:m9": "node scripts/electron.mjs test server/tests/m9_test.ts",
    "test:m10": "node scripts/electron.mjs test server/tests/m10_test.ts",
    "test:m11": "node scripts/electron.mjs test server/tests/m11_test.ts",
    "prisma:generate": "prisma generate",
    "developer:key": "tsx scripts/developer-key.ts",
    "build": "prisma generate && tsc --noEmit && electron-vite build",
    "build:unpack": "npm run build && npm run native:reset && electron-builder --dir",
    "build:win": "npm run build && npm run native:reset && electron-builder --win nsis",
    "rebuild": "npm run native:reset && electron-builder install-app-deps",
    "native:reset": "node -e \"require('fs').rmSync('node_modules/better-sqlite3/build/Release/.forge-meta',{force:true})\""
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "otplib": "^12.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "5.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "electron-winstaller": false
  }
}
